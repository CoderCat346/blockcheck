VERDICT_COLOR = {"BLOCKED": C.red, "ALLOWED": C.green, "PARTIAL": C.yellow,
                 "UNKNOWN": C.dim, "ERROR": C.mag}


def badge(v):
    return VERDICT_COLOR.get(v, C.bold)(v)


def fmt_answer(m):
    if m.get("error"):
        return f"no reply ({trunc(m['error'], 40)})"
    rc = RCODE.get(m.get("rcode"), m.get("rcode"))
    ips = ips_of(m)
    if m.get("rcode") == 0 and not ips:
        return "NOERROR (no address)"
    if ips:
        extra = ""
        if len(ips) > 4:
            extra = f" +{len(ips) - 4}"
        return f"{rc} {', '.join(ips[:4])}{extra}"
    return str(rc)


def fmt_cert(r):
    bits = []
    if r.get("cert_subject"):
        bits.append(f"cert={r['cert_subject']}")
    if r.get("cert_issuer"):
        bits.append(f"issuer={r['cert_issuer']}")
    elif r.get("issuer"):
        bits.append(f"issuer={trunc(r['issuer'], 48)}")
    if r.get("not_after"):
        bits.append(f"exp={r['not_after']}")
    if r.get("alpn"):
        bits.append(f"alpn={r['alpn']}")
    return " ".join(bits)


def render(rep, opts):
    if opts.json:
        return
    print()
    print(f"{C.bold(rep.get('target', '?'))}  {badge(rep['verdict'])}"
          + (f"  {C.dim('[' + rep['kind'] + ']')}" if rep.get("kind") else ""))
    if rep.get("error"):
        print(f"  {C.red(rep['error'])}")
        return

    p = rep.get("paths", {})
    path_line = "  ".join(f"{k}: {v}" for k, v in
                          (("dns", p.get("dns")), ("tcp", p.get("tcp")),
                           ("tls", p.get("tls")), ("ipv6", p.get("ipv6")))
                          if v)
    if path_line:
        print(f"  {C.dim('path')}      {path_line}")

    for r in rep.get("reasons", []):
        print(f"  {C.dim('reason')}    {r}")

    # dns block
    t = rep.get("truth", {})
    print(f"  {C.dim('truth')}     {t.get('source') or '-'} "
          f"({t.get('server') or '-'}) -> "
          f"{', '.join(t.get('ips', [])[:4]) or RCODE.get(t.get('rcode'), 'none')}"
          + (f"  {C.dim('ad=' + str(t.get('ad')))}" if t.get("ad") else ""))
    for label, group in (("local", rep.get("local", [])),
                         ("control", rep.get("control", [])),
                         ("doh", rep.get("doh", []))):
        shown = 0
        for m in group:
            # non-verbose: one representative line per server+record type
            if not opts.verbose and label != "local" and shown >= 2:
                continue
            if not opts.verbose and label != "local" and m.get("error"):
                continue
            if not opts.verbose and label != "local" and m.get("class") == "differs" and shown >= 1:
                continue
            mark = C.red("!") if (label == "local" and m.get("class") in BLOCKING_CLASSES) else " "
            print(f"  {mark} {label:<8} {m['server']:<15} {m['qtype_name']:<4} "
                  f"{fmt_answer(m):<40} {C.dim(dur(m['elapsed']) + '  ' + m['class'])}")
            shown += 1
        if not opts.verbose and label != "local" and group and shown == 0:
            print(f"    {C.dim(label + '     no usable answer from ' + ', '.join(sorted({m['server'] for m in group})))}")
    auth = rep.get("auth")
    if auth and not auth.get("error"):
        for m in auth["answers"]:
            print(f"    {'auth':<8} {m['server']:<15} {m['qtype_name']:<4} "
                  f"{fmt_answer(m):<40} {C.dim(dur(m['elapsed']) + ('  AA' if m.get('aa') else ''))}")
    elif auth and auth.get("error"):
        print(f"    {C.dim('auth     ' + auth['error'])}")

    # cname
    ck = rep.get("cloaking", {})
    if ck.get("chain"):
        print(f"  {C.dim('cname')}     " + " -> ".join(ck["hops"]))
        for hop in ck.get("cross_domain", []):
            tag = C.yellow("cross-domain")
            print(f"            {tag} {hop['from']} -> {hop['to']} ({hop['to_registrable']})")
        if ck.get("vendor"):
            label = "CNAME CLOAKING (first-party disguise)" if ck.get("first_party") else "third-party tracker"
            print(f"            {C.mag(label)}: {ck['tracker']} = {ck['vendor']}")
        elif ck.get("cdn"):
            print(f"            {C.dim('CDN edge: ' + ck['cdn'])}")
        if ck.get("blocked_target"):
            bt = ck["blocked_target"]
            print(f"            {C.red('chain target filtered')}: {bt['name']} ({bt['class']}) "
                  f"- the site will hang or break")
    else:
        print(f"  {C.dim('cname')}     -")

    # transport
    for r in rep.get("tls", []):
        st = r["status"]
        col = (C.green if st == "ok" else
               C.red if st in ("cert_mismatch", "tcp_fail", "tls_reset") else
               C.yellow if st.startswith("cert_") else C.red)
        head = f"{r['ip']}:{r['port']}"
        if st == "ok":
            line = f"ok  {r.get('tls')}  {fmt_cert(r)}  {C.dim(dur(r.get('elapsed', 0)))}"
        elif st.startswith("cert_"):
            line = f"{st}: {trunc(r.get('verify_error', ''), 70)}  {fmt_cert(r)}"
        elif st == "tcp_fail":
            line = f"TCP failed: {r['tcp'].get('error')}"
        else:
            line = f"{st}: {trunc(r.get('error', ''), 70)}"
        print(f"  {C.dim('tls')}       {head:<22} {col(line)}")
    if rep.get("http"):
        h = rep["http"]
        if h.get("looks_like_blockpage"):
            print(f"  {C.red('blockpage')} {h.get('status')} {trunc(h.get('final_url'), 60)} "
                  f"server={h.get('server')} title={trunc(h.get('title'), 50)!r} "
                  f"markers={','.join(h.get('markers', [])[:4])}")
        else:
            print(f"  {C.dim('http')}      {h.get('status')} {trunc(h.get('final_url'), 60)} "
                  f"{('title=' + trunc(h.get('title'), 40)) if h.get('title') else ''}")
    if rep.get("asn"):
        for a in rep["asn"]:
            print(f"  {C.dim('asn')}       {a.get('prefix')} AS{a.get('asn')} {trunc(a.get('holder'), 50)}")

    # wildcard samples
    for s in rep.get("samples", []):
        mark = C.red("!") if s["class"] in BLOCKING_CLASSES else C.yellow("?")
        print(f"  {mark} {C.dim('sample')}   {s['name']:<38} {s['class']:<10} "
              f"local={','.join(s['local_ips']) or '-'} public={','.join(s['public_ips']) or s['public_rcode']}")


def print_table(reps, opts):
    if opts.json or (len(reps) < 2 and not opts.brief) or opts.verbose:
        return

    def pad(s, w):
        s = str(s)
        return s + " " * max(0, w - len(s))

    print()
    w = max((len(r.get("target", "")) for r in reps), default=10)
    w = max(w, 6)
    print(f"{C.dim(pad('TARGET', w))}  {C.dim(pad('VERDICT', 9))} "
          f"{C.dim(pad('DNS', 11))} {C.dim(pad('TLS', 13))} {C.dim('NOTE')}")
    for r in reps:
        tgt = r.get("target", "")
        if r.get("error"):
            print(f"{pad(tgt, w)}  {badge(pad('ERROR', 9))} {pad('-', 11)} "
                  f"{pad('-', 13)} {r['error']}")
            continue
        p = r.get("paths", {})
        note = (r.get("reasons") or [""])[0]
        if not note:
            ips = r.get("truth", {}).get("ips") or []
            note = ("resolves " + ", ".join(ips[:2])) if ips else "no findings"
        print(f"{pad(tgt, w)}  {badge(pad(r['verdict'], 9))} "
              f"{pad(p.get('dns', '-'), 11)} {pad(p.get('tls', '-'), 13)} "
              f"{trunc(note, 80)}")


