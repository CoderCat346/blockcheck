def read_resolv_conf():
    out = []
    try:
        with open("/etc/resolv.conf", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.split("#")[0].strip()
                if line.lower().startswith("nameserver"):
                    parts = line.split()
                    if len(parts) >= 2:
                        out.append(parts[1])
    except OSError:
        pass
    return out or ["127.0.0.1"]


def build_parser():
    p = argparse.ArgumentParser(
        prog="blockcheck",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Check whether a domain or *.wildcard is actually blocked, and where.",
        epilog="""examples:
  blockcheck example.com
  blockcheck '*.doubleclick.net' --auth
  blockcheck -f domains.txt --json > report.json
  blockcheck ads.site.com --resolver 192.168.31.1:53 --timeout 3
  blockcheck example.com -v --asn

exit codes: 0 allowed, 2 blocked, 3 partial/unknown, 1 error""")
    p.add_argument("targets", nargs="*", help="domain, URL, or *.wildcard (use '-' for stdin)")
    p.add_argument("-f", "--file", help="read targets from file (one per line, # comments)")
    p.add_argument("-r", "--resolver", action="append", default=[],
                   help="resolver to test (ip[:port], repeatable); default: /etc/resolv.conf")
    p.add_argument("--control", action="append", default=[],
                   help="public resolver used as ground truth (repeatable)")
    p.add_argument("-t", "--timeout", type=float, default=4.0, help="per-probe timeout, s (default 4)")
    p.add_argument("--retries", type=int, default=1, help="DNS retries per server (default 1)")
    p.add_argument("--port", type=int, default=443, help="TLS port to probe (default 443)")
    p.add_argument("--http-port", type=int, default=80,
                   help="port used to fetch a block page (default 80)")
    p.add_argument("--max-ips", type=int, default=3, help="addresses to probe per name (default 3)")
    p.add_argument("--samples", type=int, default=3, help="random subdomains per wildcard (default 3)")
    p.add_argument("--seed", type=int, help="seed for wildcard samples (reproducible runs)")
    p.add_argument("--no-doh", dest="doh", action="store_false", help="skip DoH ground truth")
    p.add_argument("--dnssec", action="store_true",
                   help="set the EDNS0 DO bit (note: some middleboxes drop such queries)")
    p.add_argument("--doh-provider", default=None, help="cloudflare|google (default: try both)")
    p.add_argument("--no-tls", dest="tls", action="store_false", help="DNS-only check")
    p.add_argument("--no-http", dest="http", action="store_false", help="skip block-page fetch")
    p.add_argument("--no-chain-check", dest="check_chain_targets", action="store_false",
                   help="do not test whether CNAME targets are themselves blocked")
    p.add_argument("--auth", action="store_true", help="also query the zone's authoritative NS")
    p.add_argument("--asn", action="store_true", help="look up ASN/prefix for resolved IPs (RDAP)")
    p.add_argument("-v", "--verbose", action="store_true", help="show every resolver answer")
    p.add_argument("--brief", action="store_true", help="summary table only")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.add_argument("--quiet", action="store_true", help="no output, exit code only")
    p.add_argument("--no-color", action="store_true", help="disable ANSI colour")
    p.add_argument("--version", action="version", version=f"blockcheck {VERSION}")
    return p


def main(argv):
    opts = build_parser().parse_args(argv)
    if opts.no_color or opts.json:
        C.on = False

    raw = list(opts.targets)
    if opts.file:
        try:
            with open(opts.file, encoding="utf-8", errors="replace") as f:
                raw += [ln.strip() for ln in f]
        except OSError as e:
            print(f"blockcheck: cannot read {opts.file}: {e}", file=sys.stderr)
            return 1
    if "-" in raw:
        raw = [x for x in raw if x != "-"] + [ln.strip() for ln in sys.stdin]

    targets = [n for n in (normalize(r) for r in raw) if n]
    if not targets:
        build_parser().print_help()
        return 1

    opts.local_resolvers = [parse_server(r) for r in opts.resolver] or \
                           [parse_server(r) for r in read_resolv_conf()]
    opts.control_resolvers = opts.control or ["1.1.1.1", "8.8.8.8", "9.9.9.9"]

    if shutil.which("curl") is None:
        opts.doh = opts.http = opts.asn = False
        if not opts.json and not opts.quiet:
            print("blockcheck: curl not found - DoH, block-page and ASN checks "
                  "disabled", file=sys.stderr)
    if len(targets) == 1:
        reps = [check_target(targets[0], opts)]
    else:
        with ThreadPoolExecutor(max_workers=min(3, len(targets))) as ex:
            reps = list(ex.map(lambda t: check_target(t, opts), targets))

    if opts.json:
        doc = {"tool": "blockcheck", "version": VERSION,
               "generated": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
               "config": {"local_resolvers": [f"{h}:{p}" for h, p in
                                               opts.local_resolvers],
                          "control_resolvers": opts.control_resolvers,
                          "doh": opts.doh, "timeout": opts.timeout},
               "targets": [jsonable(r) for r in reps],
               "summary": {"total": len(reps),
                           "blocked": sum(1 for r in reps if r["verdict"] == "BLOCKED"),
                           "allowed": sum(1 for r in reps if r["verdict"] == "ALLOWED"),
                           "partial": sum(1 for r in reps if r["verdict"] == "PARTIAL"),
                           "unknown": sum(1 for r in reps if r["verdict"] in ("UNKNOWN", "ERROR"))}}
        print(json.dumps(doc, indent=2, default=str))
    elif not opts.quiet:
        if not opts.brief:
            for r in reps:
                render(r, opts)
        print_table(reps, opts)
        if len(reps) > 1 and not opts.brief:
            b = sum(1 for r in reps if r["verdict"] == "BLOCKED")
            print(f"\n{C.dim(f'{len(reps)} checked, {b} blocked')}")

    if any(r["verdict"] == "ERROR" for r in reps):
        return 1
    if any(r["verdict"] == "BLOCKED" for r in reps):
        return 2
    if any(r["verdict"] in ("PARTIAL", "UNKNOWN") for r in reps):
        return 3
    return 0


def jsonable(o):
    if isinstance(o, set):
        return sorted(o)
    if isinstance(o, dict):
        return {k: jsonable(v) for k, v in o.items()}
    if isinstance(o, (list, tuple)):
        return [jsonable(v) for v in o]
    return o


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print("\ninterrupted", file=sys.stderr)
        sys.exit(130)
