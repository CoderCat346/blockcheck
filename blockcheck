NAT64_NETS = [ipaddress.ip_network(n) for n in ("64:ff9b::/96", "64:ff9b:1::/48")]


def is_nat64(ip):
    try:
        a = ipaddress.ip_address(ip)
    except ValueError:
        return False
    return any(a in n for n in NAT64_NETS)


def ip_kind(ip):
    try:
        a = ipaddress.ip_address(ip)
    except ValueError:
        return "invalid"
    if any(a in n for n in SINKHOLE_NETS):
        return "sinkhole"
    if any(a in n for n in BLOCKPAGE_NETS):
        return "blockpage"
    if any(a in n for n in NONPUBLIC_NETS):
        return "private"
    return "public"


_PSL = None


def _load_psl():
    global _PSL
    if _PSL is not None:
        return _PSL
    _PSL = set()
    for p in ("/usr/share/publicsuffix/public_suffix_list.dat",
              "/usr/share/publicsuffix/effective_tld_names.dat",
              "/etc/public_suffix_list.dat"):
        try:
            with open(p, encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("//"):
                        _PSL.add(line.lstrip("!").lower())
            if _PSL:
                break
        except OSError:
            continue
    return _PSL


def registrable(domain):
    """eTLD+1, best effort (uses system PSL when present)."""
    d = domain.rstrip(".").lower()
    labels = d.split(".")
    if len(labels) <= 2:
        return d
    psl = _load_psl()
    for i in range(len(labels)):
        cand = ".".join(labels[i:])
        if cand in psl or cand in MULTI_SUFFIX:
            keep = len(labels) - i + 1
            return ".".join(labels[-keep:])
    return ".".join(labels[-2:])


def tracker_of(domain):
    d = domain.rstrip(".").lower()
    for t, vendor in TRACKERS.items():
        if d == t or d.endswith("." + t):
            return vendor
    return None


def is_cdn(domain):
    d = domain.rstrip(".").lower()
    return any(d == c or d.endswith("." + c) for c in CDN_SUFFIX)


def classify_dns(res, truth):
    """-> (class, note). class in ok|nxdomain|servfail|refused|nodata|sinkhole|
    blockpage|private|dropped|error|differs|nonexistent"""
    qt = res.get("qtype")
    byq = (truth.get("by_qtype") or {}).get(qt)
    if byq is not None:
        t_ok, t_ips, t_rcode = byq["ok"], byq["ips"], byq["rcode"]
    else:
        t_ok, t_ips, t_rcode = truth.get("ok"), truth.get("ips", []), truth.get("rcode")
    if res.get("error"):
        if t_ok:
            return "dropped", f"no response ({res['error'].split(':')[0]}) while public resolvers answer"
        return "error", res["error"]
    rc = res.get("rcode")
    ips = ips_of(res)
    kinds = {ip_kind(i) for i in ips}
    if rc == 3:
        if t_ok:
            return "nxdomain", "NXDOMAIN while public resolvers return an answer"
        return "nonexistent", "NXDOMAIN everywhere (name does not exist)"
    if rc == 2:
        return "servfail", "SERVFAIL (filter/upstream failure, not a normal answer)"
    if rc == 5:
        return "refused", "REFUSED by resolver"
    if rc not in (0, None):
        return "servfail", f"{RCODE.get(rc, rc)} from resolver"
    if "sinkhole" in kinds:
        return "sinkhole", f"answers sinkhole address {', '.join(ips)}"
    if "blockpage" in kinds:
        return "blockpage", f"answers known block-page address {', '.join(ips)}"
    if not ips:
        if t_ok:
            return "nodata", "NOERROR but empty answer (NODATA/RPZ) while public resolvers answer"
        return "empty", "NOERROR with no address records (same as public DNS)"
    if qt == 28 and ips and all(is_nat64(i) for i in ips):
        return "nat64", "synthesized NAT64 address (this network translates IPv6)"
    if kinds == {"private"} and t_ok and {ip_kind(i) for i in t_ips} == {"public"}:
        return "private", f"answers non-public address {', '.join(ips)} (sinkhole or split-horizon)"
    if t_ok and t_ips and set(ips) != set(t_ips):
        return "differs", "answer differs from public DNS (CDN geo-DNS is normal)"
    return "ok", ""


BLOCKING_CLASSES = {"nxdomain", "servfail", "refused", "nodata", "sinkhole",
                    "blockpage", "private", "dropped"}


