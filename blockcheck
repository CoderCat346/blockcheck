# wildcard / target handling
# --------------------------------------------------------------------------- #

def normalize(raw):
    t = raw.strip()
    if not t or t.startswith("#"):
        return None
    t = re.sub(r"^[a-zA-Z][a-zA-Z0-9+.-]*://", "", t)
    t = t.split("/")[0].split("?")[0].split("#")[0]
    if "@" in t:
        t = t.rsplit("@", 1)[1]
    if t.count(":") == 1 and not t.startswith("[") and t.rsplit(":", 1)[1].isdigit():
        t = t.rsplit(":", 1)[0]
    t = t.rstrip(".").lower()
    if t.endswith(".*"):
        return {"raw": raw.strip(), "error": "suffix wildcards (example.*) are not supported"}
    if t.startswith("*."):
        base = t[2:]
        if not base or "*" in base:
            return {"raw": raw.strip(), "error": "invalid wildcard"}
        return {"raw": raw.strip(), "kind": "wildcard", "base": base}
    if "*" in t:
        return {"raw": raw.strip(), "error": "wildcards are only supported as '*.' prefix"}
    if not re.fullmatch(r"[a-z0-9_]([a-z0-9._-]*[a-z0-9_])?", t) or ".." in t:
        return {"raw": raw.strip(), "error": "not a valid domain name"}
    return {"raw": raw.strip(), "kind": "domain", "base": t}


def rand_label(n=10, rng=None):
    rng = rng or random
    alphabet = "abcdefghijklmnopqrstuvwxyz0123456789"
    return "bc" + "".join(rng.choice(alphabet) for _ in range(n))


