def ipv6_routable(opts):
    """Can we actually reach IPv6? (proot phones often blackhole it)"""
    if getattr(opts, "_v6", None) is None:
        opts._v6 = tcp_probe("2606:4700:4700::1111", 443,
                             min(2.5, opts.timeout))["ok"]
    return opts._v6


def tcp_probe(ip, port, timeout):
    t0 = time.time()
    fam = socket.AF_INET6 if ":" in ip else socket.AF_INET
    s = socket.socket(fam, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect((ip, port))
        return {"ok": True, "elapsed": time.time() - t0, "error": None}
    except socket.timeout:
        return {"ok": False, "elapsed": time.time() - t0, "error": "timeout",
                "kind": "timeout"}
    except ConnectionResetError:
        return {"ok": False, "elapsed": time.time() - t0, "error": "connection reset",
                "kind": "reset"}
    except ConnectionRefusedError:
        return {"ok": False, "elapsed": time.time() - t0, "error": "refused",
                "kind": "refused"}
    except OSError as e:
        return {"ok": False, "elapsed": time.time() - t0, "error": str(e),
                "kind": "oserror"}
    finally:
        s.close()


def _cert_via_openssl(der):
    try:
        pem = ssl.DER_cert_to_PEM_cert(der)
        with tempfile.NamedTemporaryFile("w", suffix=".pem", delete=False) as f:
            f.write(pem)
            path = f.name
        try:
            out = subprocess.run(
                ["openssl", "x509", "-noout", "-subject", "-issuer", "-enddate",
                 "-ext", "subjectAltName"],
                stdin=open(path, "rb"), capture_output=True, text=True, timeout=8)
            txt = out.stdout
        finally:
            os.unlink(path)
        info = {}
        for line in txt.splitlines():
            line = line.strip()
            if line.startswith("subject="):
                info["subject"] = line[8:].strip()
            elif line.startswith("issuer="):
                info["issuer"] = line[7:].strip()
            elif line.startswith("notAfter="):
                info["not_after"] = line[9:].strip()
            elif line.startswith("DNS:"):
                info["san"] = [x.strip()[4:] for x in line.split(",") if x.strip().startswith("DNS:")]
        return info
    except Exception:
        return {}


def tls_probe(ip, sni, port, timeout):
    """Full TCP+TLS probe; separates IP-level from SNI-level blocking."""
    res = {"ip": ip, "port": port, "sni": sni}
    tcp = tcp_probe(ip, port, timeout)
    res["tcp"] = tcp
    if not tcp["ok"]:
        res["status"] = "tcp_fail"
        return res
    ctx = ssl.create_default_context()
    try:
        ctx.set_alpn_protocols(["h2", "http/1.1"])
    except Exception:
        pass
    t0 = time.time()
    try:
        with socket.create_connection((ip, port), timeout=timeout) as raw:
            with ctx.wrap_socket(raw, server_hostname=sni) as ss:
                cert = ss.getpeercert()
                res.update({"status": "ok", "elapsed": time.time() - t0,
                            "tls": ss.version(),
                            "alpn": ss.selected_alpn_protocol(),
                            "cipher": (ss.cipher()[0] if ss.cipher() else None),
                            "cert_subject": _cn(cert),
                            "cert_issuer": _issuer(cert),
                            "cert_san": [v for k, v in cert.get("subjectAltName", ()) if k == "DNS"],
                            "not_after": cert.get("notAfter")})
        return res
    except ssl.SSLCertVerificationError as e:
        # handshake may still complete: retry unverified to distinguish
        verr = str(e).lower()
        if "expired" in verr:
            res["status"] = "cert_expired"
        elif "hostname mismatch" in verr or "not valid for" in verr or "doesn't match" in verr:
            res["status"] = "cert_mismatch"
        else:
            res["status"] = "cert_untrusted"
        res["verify_error"] = str(e)
        try:
            c2 = ssl.create_default_context()
            c2.check_hostname = False
            c2.verify_mode = ssl.CERT_NONE
            with socket.create_connection((ip, port), timeout=timeout) as raw:
                with c2.wrap_socket(raw, server_hostname=sni) as ss:
                    der = ss.getpeercert(binary_form=True)
                    res["tls"] = ss.version()
                    res.update(_cert_via_openssl(der))
                    if cert_matches(sni, res) is False:
                        res["status"] = "cert_mismatch"
                        res["cert_for"] = ", ".join(dict.fromkeys(_cert_names(res)))[:80]
        except Exception:
            pass
        return res
    except (ssl.SSLEOFError, ssl.SSLZeroReturnError, ConnectionResetError) as e:
        res.update({"status": "tls_reset", "error": f"{type(e).__name__}: {e}"})
        return res
    except socket.timeout:
        res.update({"status": "tls_timeout", "error": "timeout during handshake"})
        return res
    except ssl.SSLError as e:
        res.update({"status": "tls_fail", "error": str(e)})
        return res
    except OSError as e:
        res.update({"status": "tls_fail", "error": str(e)})
        return res


def _cert_names(info):
    names = list(info.get("san") or [])
    m = re.search(r"CN\s*=\s*([^,/]+)", info.get("subject") or "")
    if m:
        names.append(m.group(1).strip())
    return [n.lower().rstrip(".") for n in names if n]


def cert_matches(sni, info):
    """Does the presented certificate cover `sni`? None = unknown."""
    names = _cert_names(info)
    if not names:
        return None
    sni = sni.lower().rstrip(".")
    for n in names:
        if n == sni:
            return True
        if n.startswith("*.") and sni.count(".") == n.count(".") \
                and sni.endswith(n[1:]):
            return True
    return False


def _cn(cert):
    for rdn in cert.get("subject", ()):
        for k, v in rdn:
            if k == "commonName":
                return v
    return None


def _issuer(cert):
    for rdn in cert.get("issuer", ()):
        for k, v in rdn:
            if k == "organizationName":
                return v
    for rdn in cert.get("issuer", ()):
        for k, v in rdn:
            if k == "commonName":
                return v
    return None


def http_probe(host, timeout, port=80, resolve_ip=None):
    """Fetch the block page (if any) and fingerprint it.

    resolve_ip pins the connection to a specific address (e.g. the sinkhole or
    block-page IP the local resolver returned) while keeping the Host header.
    """
    url = f"http://{host}/" if port == 80 else f"http://{host}:{port}/"
    t0 = time.time()
    pin = ["--resolve", f"{host}:{port}:{resolve_ip}"] if resolve_ip else []
    try:
        out = subprocess.run(
            ["curl", "-sS", "-L", "--max-redirs", "3",
             "--max-time", str(max(3, timeout)), *pin,
             "-A", "Mozilla/5.0 (blockcheck)", "-o", "-", "-D", "-",
             "-w", "\n@@@%{http_code} %{url_effective} %{remote_ip}", url],
            capture_output=True, text=True, timeout=timeout + 4, errors="replace")
        body = out.stdout or ""
        meta = ""
        if "@@@" in body:
            body, _, meta = body.rpartition("@@@")
        code, _, rest = meta.partition(" ")
        eff, _, remote = rest.partition(" ")
        # text mode normalises CRLF, so headers end at a blank \n\n
        head, _, content = body.partition("\n\n")
        low = content.lower()
        hits = sorted({m for m in BLOCKPAGE_MARKERS if m in low})
        title = ""
        m = re.search(r"<title[^>]*>(.*?)</title>", content, re.I | re.S)
        if m:
            title = re.sub(r"\s+", " ", m.group(1)).strip()[:120]
        server = ""
        for line in head.splitlines():
            if line.lower().startswith("server:"):
                server = line.split(":", 1)[1].strip()
        return {"status": code or None, "final_url": eff or url,
                "remote_ip": remote or None, "server": server, "title": title,
                "markers": hits, "elapsed": time.time() - t0,
                "error": out.stderr.strip()[:160] or None,
                "looks_like_blockpage": bool(hits) and (code in ("403", "451", "302", "200") or len(hits) > 1)}
    except Exception as e:
        return {"status": None, "error": f"{type(e).__name__}: {e}",
                "elapsed": time.time() - t0, "markers": [],
                "looks_like_blockpage": False}


def asn_lookup(ip, timeout):
    try:
        out = subprocess.run(
            ["curl", "-sS", "--max-time", str(max(3, timeout)),
             f"https://stat.ripe.net/data/prefix-overview/data.json?resource={ip}"],
            capture_output=True, text=True, timeout=timeout + 3)
        js = json.loads(out.stdout)
        d = js.get("data", {})
        asns = d.get("asns") or []
        return {"prefix": d.get("resource"), "asn": asns[0].get("asn") if asns else None,
                "holder": asns[0].get("holder") if asns else None}
    except Exception:
        return None


