class DNSError(Exception):
    pass


def parse_server(spec):
    if isinstance(spec, tuple):
        return spec
    spec = spec.strip()
    if spec.startswith("["):
        host, _, rest = spec[1:].partition("]")
        port = int(rest[1:]) if rest.startswith(":") else 53
        return host, port
    if spec.count(":") == 1:
        host, port = spec.split(":")
        return host, int(port)
    return spec, 53


def _encode_name(name):
    out = b""
    for label in name.rstrip(".").split("."):
        if not label:
            continue
        try:
            b = label.encode("idna")
        except UnicodeError:
            b = label.encode("ascii", "replace")
        if len(b) > 63:
            raise DNSError(f"label too long: {label}")
        out += bytes([len(b)]) + b
    return out + b"\x00"


def _read_name(buf, off):
    labels, jumped, orig, seen = [], False, None, set()
    while True:
        if off >= len(buf):
            raise DNSError("truncated name")
        ln = buf[off]
        if ln == 0:
            off += 1
            break
        if ln & 0xC0 == 0xC0:
            if off + 1 >= len(buf):
                raise DNSError("truncated pointer")
            ptr = struct.unpack("!H", buf[off:off + 2])[0] & 0x3FFF
            if orig is None:
                orig = off + 2
            if ptr in seen:
                raise DNSError("compression loop")
            seen.add(ptr)
            off, jumped = ptr, True
            continue
        off += 1
        labels.append(buf[off:off + ln].decode("ascii", "replace"))
        off += ln
    return ".".join(labels), (orig if jumped else off)


def _fmt_rdata(buf, rtype, rd, off):
    """Best-effort human form of RDATA. off = absolute offset of rd in buf."""
    try:
        if rtype == 1 and len(rd) == 4:
            return socket.inet_ntop(socket.AF_INET, rd)
        if rtype == 28 and len(rd) == 16:
            return socket.inet_ntop(socket.AF_INET6, rd)
        if rtype in (2, 5, 12, 39):
            return _read_name(buf, off)[0]
        if rtype == 6:
            m, o2 = _read_name(buf, off)
            r, o3 = _read_name(buf, o2)
            serial = struct.unpack("!I", buf[o3:o3 + 4])[0]
            return f"{m} {r} serial={serial}"
        if rtype == 15:
            pref = struct.unpack("!H", rd[:2])[0]
            return f"{pref} {_read_name(buf, off + 2)[0]}"
        if rtype == 16:
            parts, i = [], 0
            while i < len(rd):
                ln = rd[i]
                parts.append(rd[i + 1:i + 1 + ln].decode("utf-8", "replace"))
                i += 1 + ln
            return '"' + '" "'.join(parts) + '"'
        if rtype in (64, 65):
            prio = struct.unpack("!H", rd[:2])[0]
            target, o = _read_name(buf, off + 2)
            params = ""
            while o + 4 <= off + len(rd):
                k, ln = struct.unpack("!HH", buf[o:o + 4])
                val = buf[o + 4:o + 4 + ln]
                params += f" key{k}=" + val.hex()
                o += 4 + ln
            return f"{prio} {target}{params}"
        if rtype == 257:
            fl = struct.unpack("!B", rd[:1])[0]
            tag = rd[2:2 + rd[1]].decode("ascii", "replace")
            return f'{fl} {tag} "{rd[3 + rd[1]:].decode("ascii", "replace")}"'
        if rtype == 33:
            pr, wt, po = struct.unpack("!HHH", rd[:6])
            return f"{pr} {wt} {po} {_read_name(buf, off + 6)[0]}"
        if rtype == 46:
            return f"RRSIG type={struct.unpack('!H', rd[:2])[0]}"
        if rtype == 43:
            return f"DS keytag={struct.unpack('!H', rd[:2])[0]}"
    except Exception:
        pass
    return rd.hex() if len(rd) <= 24 else rd[:24].hex() + "..."


def _parse(buf):
    if len(buf) < 12:
        raise DNSError("short message")
    tid, flags, qd, an, ns, ar = struct.unpack("!HHHHHH", buf[:12])
    rcode = flags & 0xF
    msg = {"id": tid, "flags": flags, "rcode": rcode, "qd": qd,
           "aa": bool(flags & 0x0400), "tc": bool(flags & 0x0200),
           "ra": bool(flags & 0x0080), "ad": bool(flags & 0x0020),
           "questions": [], "answer": [], "authority": [], "additional": []}
    off = 12
    for _ in range(qd):
        n, off = _read_name(buf, off)
        qt, qc = struct.unpack("!HH", buf[off:off + 4])
        off += 4
        msg["questions"].append((n, qt))

    def section(count):
        nonlocal off
        out = []
        for _ in range(count):
            n, off = _read_name(buf, off)
            rt, rc, ttl, rdl = struct.unpack("!HHIH", buf[off:off + 10])
            off += 10
            rd_off = off
            rd = buf[off:off + rdl]
            off += rdl
            if rt == 41:  # OPT: extended rcode
                msg["rcode"] |= ((ttl >> 24) & 0xFF) << 4
                continue
            out.append({"name": n, "type": rt, "type_name": QT.get(rt, str(rt)),
                        "ttl": ttl, "data": _fmt_rdata(buf, rt, rd, rd_off)})
        return out

    msg["answer"] = section(an)
    msg["authority"] = section(ns)
    msg["additional"] = section(ar)
    return msg


def _udp(buf, tid, server, timeout):
    host, port = server
    fam = socket.AF_INET6 if ":" in host else socket.AF_INET
    s = socket.socket(fam, socket.SOCK_DGRAM)
    s.settimeout(timeout)
    try:
        s.sendto(buf, (host, port))
        deadline = time.time() + timeout
        while True:
            left = deadline - time.time()
            if left <= 0:
                raise socket.timeout()
            s.settimeout(left)
            data, _ = s.recvfrom(4096)
            if len(data) >= 2 and struct.unpack("!H", data[:2])[0] == tid:
                return data
    finally:
        s.close()


def _tcp(buf, tid, server, timeout):
    host, port = server
    with socket.create_connection((host, port), timeout=timeout) as s:
        s.settimeout(timeout)
        s.sendall(struct.pack("!H", len(buf)) + buf)
        hdr = s.recv(2)
        if len(hdr) < 2:
            raise DNSError("short TCP reply")
        want = struct.unpack("!H", hdr)[0]
        data = b""
        while len(data) < want:
            chunk = s.recv(want - len(data))
            if not chunk:
                break
            data += chunk
        return data


def dns_query(name, qtype, server, timeout=4.0, rd=True, dnssec=True,
              force_tcp=False, retries=1):
    """Return dict(server, qtype, rcode, answer[], authority[], elapsed, ...)."""
    srv = parse_server(server) if isinstance(server, str) else server
    tid = random.randint(0, 0xFFFF)
    hdr = struct.pack("!HHHHHH", tid, 0x0100 if rd else 0x0000, 1, 0, 0, 1 if dnssec else 0)
    q = _encode_name(name) + struct.pack("!HH", qtype, 1)
    opt = b"\x00" + struct.pack("!HHIH", 41, 1232, 0, 0x8000) if dnssec else b""
    buf = hdr + q + opt
    t0 = time.time()
    last = None
    for attempt in range(max(1, retries)):
        try:
            if force_tcp:
                raw = _tcp(buf, tid, srv, timeout)
            else:
                raw = _udp(buf, tid, srv, timeout)
                if len(raw) > 12 and struct.unpack("!H", raw[2:4])[0] & 0x0200:
                    raw = _tcp(buf, tid, srv, timeout)  # truncated -> TCP
            msg = _parse(raw)
            msg.update({"server": srv[0], "port": srv[1],
                        "qtype": qtype, "qtype_name": QT.get(qtype, str(qtype)),
                        "elapsed": time.time() - t0, "error": None,
                        "proto": "tcp" if force_tcp else "udp"})
            return msg
        except Exception as e:
            last = e
    raise DNSError(f"{type(last).__name__}: {last}")


def _q(name, qtype, server, opts, **kw):
    """dns_query wrapper returning an error-record instead of raising."""
    t0 = time.time()
    try:
        r = dns_query(name, qtype, server, timeout=opts.timeout,
                      retries=opts.retries, dnssec=opts.dnssec, **kw)
        return r
    except Exception as e:
        return {"server": parse_server(server)[0], "port": parse_server(server)[1],
                "qtype": qtype, "qtype_name": QT.get(qtype, str(qtype)),
                "rcode": None, "answer": [], "authority": [], "additional": [],
                "elapsed": time.time() - t0, "error": str(e), "aa": False,
                "ad": False, "questions": []}


def ips_of(msg, qtype=None):
    out = []
    for rr in msg.get("answer", []):
        if rr["type"] in (1, 28) and (qtype is None or rr["type"] == qtype):
            out.append(rr["data"])
    return out


def cname_chain(msg):
    """Follow CNAME/DNAME records from the qname; returns list of hops."""
    qname = msg["questions"][0][0].rstrip(".").lower() if msg.get("questions") else ""
    chain, cur, guard = [], qname, 0
    while guard < 16:
        guard += 1
        nxt = None
        for rr in msg.get("answer", []):
            if rr["type"] in (5, 39) and rr["name"].rstrip(".").lower() == cur:
                nxt = rr["data"].rstrip(".").lower()
                break
        if not nxt or nxt == cur:
            break
        chain.append((cur, nxt))
        cur = nxt
    return chain


