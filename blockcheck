def dur(seconds):
    """Format a duration (already elapsed), not a timestamp."""
    try:
        return f"{int(round(float(seconds) * 1000))} ms"
    except (TypeError, ValueError):
        return "-"


def trunc(s, n):
    s = str(s)
    return s if len(s) <= n else s[: n - 1] + "\u2026"


