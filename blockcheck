def doh_query(name, qtype, opts, provider=None):
    providers = [("cloudflare", "https://cloudflare-dns.com/dns-query"),
                 ("google", "https://dns.google/resolve")]
    if provider:
        providers = [p for p in providers if p[0] == provider] or providers
    t0 = time.time()
    err = None
    for pname, base in providers:
        url = f"{base}?name={name}&type={QT.get(qtype, 'A')}&ct=application/dns-json"
        try:
            out = subprocess.run(
                ["curl", "-sS", "--max-time", str(max(3, opts.timeout)),
                 "-H", "accept: application/dns-json", url],
                capture_output=True, text=True, timeout=opts.timeout + 3)
            if out.returncode != 0:
                err = out.stderr.strip()[:120]
                continue
            js = json.loads(out.stdout)
            ans = []
            for a in js.get("Answer", []):
                t = a.get("type", 0)
                ans.append({"name": a.get("name", name), "type": t,
                            "type_name": QT.get(t, str(t)), "ttl": a.get("TTL", 0),
                            "data": a.get("data", "")})
            return {"server": pname, "port": 443, "qtype": qtype,
                    "qtype_name": QT.get(qtype, "A"), "rcode": js.get("Status", 0),
                    "answer": ans, "authority": [], "additional": [],
                    "elapsed": time.time() - t0, "error": None,
                    "aa": False, "ad": bool(js.get("AD")),
                    "questions": [(name, qtype)], "proto": "doh"}
        except Exception as e:
            err = f"{type(e).__name__}: {e}"
    return {"server": provider or "doh", "port": 443, "qtype": qtype,
            "qtype_name": QT.get(qtype, "A"), "rcode": None, "answer": [],
            "authority": [], "additional": [], "elapsed": time.time() - t0,
            "error": err, "aa": False, "ad": False, "questions": [(name, qtype)],
            "proto": "doh"}


