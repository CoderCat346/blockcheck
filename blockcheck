# the check itself
# --------------------------------------------------------------------------- #

def check_name(name, opts, want_tls=False, want_aaaa=True):
    """Resolve `name` across local / control / DoH (and authoritative), probe
    the transport, and classify. Returns a report dict."""
    qtypes = [1, 28] if want_aaaa else [1]
    jobs = {}
    with ThreadPoolExecutor(max_workers=16) as ex:
        for srv in opts.local_resolvers:
            for qt in qtypes:
                jobs[("local", srv, qt)] = ex.submit(_q, name, qt, srv, opts)
        for srv in opts.control_resolvers:
            for qt in qtypes:
                jobs[("control", srv, qt)] = ex.submit(_q, name, qt, srv, opts)
        if opts.doh:
            for qt in qtypes:
                jobs[("doh", opts.doh_provider, qt)] = ex.submit(
                    doh_query, name, qt, opts, opts.doh_provider)
        res = {k: f.result() for k, f in jobs.items()}

    local = sorted((v for (kind, _, _), v in res.items() if kind == "local"),
                   key=lambda m: (m["server"], m["qtype"]))
    control = sorted((v for (kind, _, _), v in res.items() if kind == "control"),
                     key=lambda m: (m["server"], m["qtype"]))
    doh = sorted((v for (kind, _, _), v in res.items() if kind == "doh"),
                 key=lambda m: (m["server"], m["qtype"]))
    for grp, name_ in ((local, "local"), (control, "control"), (doh, "doh")):
        for m in grp:
            m["group"] = name_

    # Ground truth per record type: DoH is hardest to intercept, then public
    # resolvers, then whatever the local resolver says.
    by_qtype, primary_msg = {}, None
    for qt in qtypes:
        chosen = None
        for group in (doh, control, local):
            for m in group:
                if m["qtype"] == qt and m.get("error") is None and m.get("rcode") in (0, 3):
                    chosen = m
                    break
            if chosen:
                break
        if not chosen:
            continue
        ips = ips_of(chosen)
        by_qtype[qt] = {"ok": chosen["rcode"] == 0 and bool(ips),
                        "rcode": chosen["rcode"], "ips": ips,
                        "source": chosen.get("group"),
                        "server": chosen["server"], "answer": chosen["answer"],
                        "ad": chosen.get("ad", False), "_msg": chosen}
        if qt == 1 or primary_msg is None:
            primary_msg = chosen

    if primary_msg is not None:
        p = by_qtype.get(primary_msg["qtype"], {})
        truth = {"ok": any(v["ok"] for v in by_qtype.values()),
                 "source": p.get("source"), "server": p.get("server"),
                 "rcode": p.get("rcode"),
                 "ips": [i for v in by_qtype.values() for i in v["ips"]],
                 "kinds": {ip_kind(i) for v in by_qtype.values() for i in v["ips"]},
                 "chain": cname_chain(primary_msg), "answer": p.get("answer", []),
                 "ad": p.get("ad", False),
                 "by_qtype": {k: {kk: vv for kk, vv in v.items() if kk != "_msg"}
                              for k, v in by_qtype.items()}}
    else:
        truth = {"ok": False, "source": None, "rcode": None, "ips": [],
                 "kinds": set(), "chain": [], "answer": [], "ad": False,
                 "by_qtype": {}}

    for m in local + control + doh:
        cls, note = classify_dns(m, truth)
        m["class"], m["note"] = cls, note

    # transparent port-53 interception: on-path box answers differently from DoH
    interception53 = None
    if truth.get("source") == "doh" and truth["ok"]:
        for m in control:
            b = by_qtype.get(m["qtype"])
            if not b or m.get("error") is not None:
                continue
            if m.get("rcode") != b["rcode"] or (
                    ips_of(m) and set(ips_of(m)) != set(b["ips"])
                    and {ip_kind(i) for i in ips_of(m)} & {"sinkhole", "blockpage", "private"}):
                interception53 = (f"public resolver {m['server']} answers "
                                  f"{RCODE.get(m['rcode'], m['rcode'])} "
                                  f"{', '.join(ips_of(m)) or ''} but DoH says "
                                  f"{RCODE.get(b['rcode'], b['rcode'])} "
                                  f"{', '.join(b['ips'])}: port 53 is intercepted on-path")
                break

    # ---- authoritative check (optional) ---------------------------------- #
    auth = None
    if opts.auth:
        auth = authoritative(name, opts)

    # ---- CNAME analysis -------------------------------------------------- #
    chain = truth["chain"]
    if not chain:
        for m in local:
            if m.get("class") in ("ok", "differs"):
                chain = cname_chain(m)
                if chain:
                    break
    hops = [name] + [dst for _, dst in chain]
    cloaking = {"chain": [[a, b] for a, b in chain], "hops": hops,
                "cross_domain": [], "tracker": None, "vendor": None,
                "cdn": None, "first_party": False, "blocked_target": None}
    base_reg = registrable(name)
    for src, dst in chain:
        if registrable(dst) != registrable(src):
            cloaking["cross_domain"].append({"from": src, "to": dst,
                                             "to_registrable": registrable(dst)})
    if chain:
        final = chain[-1][1]
        vendor = tracker_of(final)
        if vendor:
            cloaking["tracker"] = final
            cloaking["vendor"] = vendor
            cloaking["first_party"] = registrable(name) != registrable(final)
        elif is_cdn(final):
            cloaking["cdn"] = final
        # is the chain target itself filtered? (classic site-hangs symptom)
        if opts.check_chain_targets and registrable(final) != registrable(name):
            lo = _q(final, 1, opts.local_resolvers[0], opts)
            tr = _q(final, 1, opts.control_resolvers[0], opts)
            t_ok = tr.get("rcode") == 0 and bool(ips_of(tr))
            t = {"ok": t_ok, "ips": ips_of(tr), "rcode": tr.get("rcode"),
                 "by_qtype": {1: {"ok": t_ok, "ips": ips_of(tr),
                                  "rcode": tr.get("rcode")}}}
            c, note = classify_dns(lo, t)
            if c in BLOCKING_CLASSES:
                cloaking["blocked_target"] = {"name": final, "class": c,
                                              "note": note or c}

    # ---- transport ------------------------------------------------------- #
    tls, http, asns = [], None, []
    blockpage_ip = next((ip for m in local if m.get("class") == "blockpage"
                         for ip in ips_of(m) if ip_kind(ip) == "blockpage"), None)
    probe_ips = [i for i in truth["ips"] if ip_kind(i) == "public"] or truth["ips"]
    v6_skipped = False
    if any(":" in i for i in probe_ips) and not ipv6_routable(opts):
        v6_skipped = True
        probe_ips = [i for i in probe_ips if ":" not in i] or probe_ips
    if want_tls and probe_ips and opts.tls:
        seen = set()
        cand = []
        for ip in probe_ips:
            if ip in seen:
                continue
            seen.add(ip)
            cand.append(ip)
            if len(cand) >= opts.max_ips:
                break
        with ThreadPoolExecutor(max_workers=6) as ex:
            futs = {ex.submit(tls_probe, ip, name, opts.port, opts.timeout): ip
                    for ip in cand}
            tls = [f.result() for f in futs]
        tls.sort(key=lambda r: 0 if r["status"] == "ok" else 1)
        if opts.asn and cand:
            with ThreadPoolExecutor(max_workers=4) as ex:
                asns = [a for a in ex.map(lambda i: asn_lookup(i, opts.timeout), cand[:4]) if a]
        hs = any(r["status"] in ("ok", "cert_expired", "cert_mismatch", "cert_untrusted")
                 for r in tls)
        if not hs and opts.http:
            http = http_probe(name, opts.timeout, port=opts.http_port)

    # a resolver that answers with a block-page IP: fetch that page and
    # fingerprint it, even when direct TLS to the real host works
    if blockpage_ip and opts.http and http is None:
        http = http_probe(name, opts.timeout, port=opts.http_port,
                          resolve_ip=blockpage_ip)

    if http and http.get("looks_like_blockpage"):
        reasons.append("block page served"
                       + (f" by {http['server']}" if http.get("server") else "")
                       + (f": {http['title']}" if http.get("title") else ""))

    # ---- verdict --------------------------------------------------------- #
    reasons, paths = [], {}
    dns_blocked = [m for m in local if m.get("class") in BLOCKING_CLASSES]

    grouped = {}
    for m in dns_blocked:
        grouped.setdefault((m["server"], m["class"]), []).append(m["qtype_name"])
    for (srv, cls), qts in grouped.items():
        note = next(m["note"] for m in dns_blocked
                    if m["server"] == srv and m["class"] == cls)
        reasons.append(f"{srv} [{','.join(qts)}]: {note}")
    if interception53:
        reasons.append(interception53)
    if truth["source"] == "doh" and dns_blocked and truth["ok"]:
        reasons.append(f"DoH ({truth['server']}) confirms the name is live: "
                       f"{', '.join(truth['ips'][:3])}")

    tls_ok = any(r["status"] == "ok" for r in tls)
    handshake_ok = any(r["status"] in ("ok", "cert_expired", "cert_mismatch",
                                       "cert_untrusted") for r in tls)
    tcp_ok = any(r.get("tcp", {}).get("ok") for r in tls)
    sni_block = bool(tls) and tcp_ok and not handshake_ok
    ip_block = bool(tls) and not tcp_ok
    mismatch = any(r["status"] == "cert_mismatch" for r in tls)
    untrusted = any(r["status"] == "cert_untrusted" for r in tls)
    expired = any(r["status"] == "cert_expired" for r in tls)
    interception = mismatch

    if dns_blocked:
        paths["dns"] = "filtered"
    elif truth["ok"]:
        paths["dns"] = "ok"
    elif truth["rcode"] == 3:
        paths["dns"] = "nxdomain"
    else:
        paths["dns"] = "unknown"
    if tls:
        paths["tcp"] = "open" if tcp_ok else "blocked"
        paths["tls"] = ("ok" if tls_ok else
                        "cert-mismatch" if mismatch else
                        "cert-untrusted" if untrusted else
                        "cert-expired" if expired else
                        "sni-filtered" if sni_block else "failed")

    # a failed TCP connect only means "blocked" if the network works at all
    egress_ok = True
    if ip_block:
        egress_ok = ensure_baseline(opts)
        if not egress_ok:
            paths["tcp"] = "unreachable"
            paths["tls"] = "n/a"

    blocked = bool(dns_blocked) or (ip_block and egress_ok) or sni_block or interception
    if blocked:
        verdict = "BLOCKED"
    elif truth["ok"]:
        verdict = "ALLOWED"
    else:
        verdict = "UNKNOWN"

    if ip_block and egress_ok:
        reasons.append("TCP connect fails to every resolved address "
                       "(IP/port block, or the host is down)")
    if ip_block and not egress_ok:
        reasons.append("no outbound TCP/443 at all from this network: "
                       "cannot tell a block from a broken uplink")
    if sni_block:
        reasons.append("TCP connects but TLS fails for this SNI "
                       "(SNI-based filtering or reset)")
    if interception:
        reasons.append("certificate is for a different name: MITM or block portal")
    if untrusted:
        reasons.append("certificate is not trusted (self-signed or an "
                       "inspection CA): possible TLS interception")
    if expired:
        reasons.append("certificate expired: the site's own problem, not a block")
    if dns_blocked and tls_ok:
        reasons.append("direct IP connectivity still works: DNS-only block, "
                       "reachable via DoH or a different resolver")
    if v6_skipped:
        paths["ipv6"] = "unreachable"
    if truth["rcode"] == 3 and not dns_blocked:
        reasons.append("NXDOMAIN from every resolver: name does not exist "
                       "(not a block)")

    return {"name": name, "verdict": verdict, "blocked": blocked,
            "reasons": reasons, "paths": paths, "truth": truth,
            "local": local, "control": control, "doh": doh, "auth": auth,
            "cloaking": cloaking, "tls": tls, "http": http, "asn": asns,
            "timing": {"checked": time.strftime("%Y-%m-%dT%H:%M:%S%z")}}


def ensure_baseline(opts):
    """Is outbound 443 working at all here? Cached per run."""
    if getattr(opts, "_baseline", None) is None:
        opts._baseline = any(tcp_probe(ip, 443, min(3.0, opts.timeout))["ok"]
                             for ip in ("1.1.1.1", "8.8.8.8", "9.9.9.9"))
    return opts._baseline


def authoritative(name, opts):
    """Ask the zone's own nameservers, bypassing every recursive resolver."""
    labels = name.split(".")
    ns_names, zone = [], name
    for i in range(len(labels)):
        cand = ".".join(labels[i:])
        r = _q(cand, 2, opts.control_resolvers[0], opts, rd=True)
        ns = [a["data"] for a in r.get("answer", []) if a["type"] == 2]
        if ns:
            ns_names, zone = ns, cand
            break
    if not ns_names:
        return {"error": "could not find NS for any parent zone"}
    ips = []
    for ns in ns_names[:4]:
        r = _q(ns.rstrip("."), 1, opts.control_resolvers[0], opts)
        ips += ips_of(r)
    if not ips:
        return {"error": f"could not resolve NS addresses ({', '.join(ns_names[:3])})"}
    out = {"zone": zone, "ns": ns_names[:4], "answers": []}
    for ip in ips[:3]:
        r = _q(name, 1, (ip, 53), opts, rd=False)
        r["class"], r["note"] = classify_dns(r, {"ok": False, "ips": [], "kinds": set()})
        out["answers"].append(r)
    return out


def check_target(target, opts):
    """target: normalized dict. Handles wildcard expansion + samples."""
    if target.get("error"):
        return {"target": target["raw"], "kind": "invalid", "verdict": "ERROR",
                "blocked": False, "reasons": [target["error"]], "error": target["error"]}

    if target["kind"] == "domain":
        rep = check_name(target["base"], opts, want_tls=True)
        rep.update({"target": target["base"], "raw": target["raw"],
                    "kind": "domain"})
        return rep

    # wildcard: full check of the apex, then N random subdomains (DNS only)
    base = target["base"]
    apex = check_name(base, opts, want_tls=True)
    rng = random.Random(opts.seed) if opts.seed is not None else random
    samples = [f"{rand_label(10, rng)}.{base}" for _ in range(opts.samples)]
    rows = []
    with ThreadPoolExecutor(max_workers=8) as ex:
        futs = {}
        for s in samples:
            futs[(s, "local")] = ex.submit(_q, s, 1, opts.local_resolvers[0], opts)
            futs[(s, "truth")] = ex.submit(_q, s, 1, opts.control_resolvers[0], opts)
        for s in samples:
            lo = futs[(s, "local")].result()
            tr = futs[(s, "truth")].result()
            truth_like = {"ok": bool(ips_of(tr)), "rcode": tr.get("rcode"),
                          "ips": ips_of(tr),
                          "kinds": {ip_kind(i) for i in ips_of(tr)}}
            cls, note = classify_dns(lo, truth_like)
            rows.append({"name": s, "class": cls, "note": note,
                         "local_ips": ips_of(lo), "public_ips": ips_of(tr),
                         "public_rcode": RCODE.get(tr.get("rcode"), tr.get("rcode")),
                         "public_wildcard": bool(ips_of(tr))})

    # only samples that actually resolve locally can "leak"; a name that
    # resolves nowhere is not a hole in the rule
    resolvable = [r for r in rows if r["local_ips"]]
    leaks = [r for r in resolvable if r["class"] not in BLOCKING_CLASSES]
    blocked_s = [r for r in resolvable if r["class"] in BLOCKING_CLASSES]

    reasons = list(apex["reasons"])
    if not rows:
        wc_verdict = apex["verdict"]
    elif leaks:
        wc_verdict = "PARTIAL"
        reasons.append(f"wildcard leak: {leaks[0]['name']} is not filtered "
                       f"({', '.join(leaks[0]['local_ips'])})")
    elif blocked_s:
        wc_verdict = "BLOCKED"
        reasons.append(f"all {len(blocked_s)} randomly named subdomains are "
                       f"filtered as well")
    else:
        wc_verdict = apex["verdict"]
        reasons.append("the zone publishes no wildcard address records, so a "
                       "'*.' rule has nothing extra to cover beyond the apex")

    apex.update({"target": target["base"], "raw": target["raw"],
                 "kind": "wildcard", "base": base,
                 "samples": rows, "verdict": wc_verdict,
                 "blocked": wc_verdict == "BLOCKED",
                 "reasons": reasons})
    return apex


